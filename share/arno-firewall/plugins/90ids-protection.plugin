# ------------------------------------------------------------------------------------------

# Plugin start function
plugin_start()
{
  local family type families host port interface IFS

  if [ "$IPV6_DETECTED" = "1" ] && [ "$IDS_IPV6_ENABLE" = "0" ]; then
    echo "${INDENT}NOTE: Only IPv4 is protected."
  fi


  # Create new IDS_LOG_DROP chain for loggin' 'n droppin':
  nft_chain IDS_LOG_DROP

  nft_rule IDS_LOG_DROP "limit rate 1/minute burst 1 packets log prefix \"AIF:IDS violation: \" level $LOGLEVEL"
  nft_rule IDS_LOG_DROP "drop"

  # Create new IDS_CHK to insert IDS checker + whitelist:
  nft_chain IDS_CHK

  if [ -n "$IDS_TRUSTED_HOSTS" ]; then
    # Create whitelist:
    echo "${INDENT}Allowing bypass of IDS protection checks for: $IDS_TRUSTED_HOSTS"
    IFS=' ,'
    for host in `nft_hosts "$IDS_TRUSTED_HOSTS"`; do
      nft_rule IDS_CHK "$(nft_addr saddr $host) return"
    done
  fi

  # We also ignore ICMP traffic since we can not reliabily check it for IDS
  nft_rule IDS_CHK "meta l4proto { icmp, ipv6-icmp } return"
  
  if [ -n "$IDS_EXCLUDE_TCP" ]; then
    echo "${INDENT}Excluding IDS check for TCP port(s): $IDS_EXCLUDE_TCP"
    IFS=' ,'
    for port in $IDS_EXCLUDE_TCP; do
      nft_rule IDS_CHK "tcp dport $port return"
    done
  fi

  if [ -n "$IDS_EXCLUDE_UDP" ]; then
    echo "${INDENT}Excluding IDS check for UDP port(s): $IDS_EXCLUDE_UDP"
    IFS=' ,'
    for port in $IDS_EXCLUDE_UDP; do
      nft_rule IDS_CHK "udp dport $port return"
    done
  fi

  # Without IPv6 protection, only IPv4 sources are checked (as it always did)
  families="ip ip6"
  if [ "$IDS_IPV6_ENABLE" = "0" ]; then
    families="ip"
  fi

  # Sources exceeding rate1 or rate2 are banned for the corresponding time:
  for family in $families; do
    if [ "$family" = "ip" ]; then type="ipv4_addr"; else type="ipv6_addr"; fi
    nft_cmd "add set inet $NFT_TABLE aif_idschk1_$family { type $type; flags dynamic,timeout; timeout ${IDS_MAX_TIME1}s; }"
    nft_cmd "add set inet $NFT_TABLE aif_idschk2_$family { type $type; flags dynamic,timeout; timeout ${IDS_MAX_TIME2}s; }"
    nft_cmd "add set inet $NFT_TABLE aif_idsban_$family { type $type; flags dynamic,timeout; timeout ${IDS_MAX_TIME2}s; }"
    nft_rule IDS_CHK "update @aif_idschk1_$family { $family saddr $(nft_rate $IDS_MAX_RATE1 $IDS_MAX_TIME1) } update @aif_idsban_$family { $family saddr timeout ${IDS_MAX_TIME1}s }"
    nft_rule IDS_CHK "update @aif_idschk2_$family { $family saddr $(nft_rate $IDS_MAX_RATE2 $IDS_MAX_TIME2) } update @aif_idsban_$family { $family saddr timeout ${IDS_MAX_TIME2}s }"
  done

  if [ -z "$IDS_INTERFACE" ]; then
    IDS_INTERFACE="$EXT_IF"
  fi

  IFS=' ,'
  for interface in $IDS_INTERFACE; do
    # Drop everything from banned sources:
    for family in $families; do
      nft_rule INPUT_CHAIN "$(nft_if iifname $interface) $family saddr @aif_idsban_$family jump IDS_LOG_DROP"
    done

    # Insert rule into the POST_INPUT_DROP_CHAIN chain:
    nft_rule POST_INPUT_DROP_CHAIN "$(nft_if iifname $interface) ct state new jump IDS_CHK"
  done

  return 0
}


# Plugin stop function
plugin_stop()
{
  return 0
}


# Plugin status function
plugin_status()
{
  return 0
}

# Check sanity of eg. environment
plugin_sanity_check()
{
  if [ -z "$IDS_MAX_RATE1" -o -z "$IDS_MAX_TIME1" -o -z "$IDS_MAX_RATE2" -o -z "$IDS_MAX_TIME2" ]; then
    printf "\033[40m\033[1;31m${INDENT}ERROR: The plugin config file is not properly set!\033[0m\n" >&2
    return 1
  fi

  return 0
}


############
# Mainline #
############

# Check where to find the config file
CONF_FILE=""
if [ -n "$PLUGIN_CONF_PATH" ]; then
  CONF_FILE="$PLUGIN_CONF_PATH/$PLUGIN_CONF_FILE"
fi

# Preinit to success:
PLUGIN_RET_VAL=0

# Check if the config file exists
if [ ! -f "$CONF_FILE" ]; then
  printf "NOTE: Config file \"$CONF_FILE\" not found!\n        Plugin \"$PLUGIN_NAME v$PLUGIN_VERSION\" ignored!\n" >&2
else
  # Source the plugin config file
  . "$CONF_FILE"

  if [ "$ENABLED" = "1" ] ||
     [ -n "$PLUGIN_LOAD_FILE" -a "$PLUGIN_CMD" = "stop" ] ||
     [ -n "$PLUGIN_LOAD_FILE" -a "$PLUGIN_CMD" = "status" ]; then
    # Show who we are:
    echo "${INDENT}$PLUGIN_NAME v$PLUGIN_VERSION"

    # Increment indention
    INDENT="$INDENT "

    # Only proceed if environment ok
    if ! plugin_sanity_check; then
      PLUGIN_RET_VAL=1
    else
      case $PLUGIN_CMD in
        start|'') plugin_start; PLUGIN_RET_VAL=$? ;;
        stop    ) plugin_stop; PLUGIN_RET_VAL=$? ;;
        status  ) plugin_status; PLUGIN_RET_VAL=$? ;;
        *       ) PLUGIN_RET_VAL=1; printf "\033[40m\033[1;31m${INDENT}ERROR: Invalid plugin option \"$PLUGIN_CMD\"!\033[0m\n" >&2 ;;
      esac
    fi
  fi
fi
