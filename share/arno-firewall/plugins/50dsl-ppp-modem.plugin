PLUGIN_NAME="(A)DSL PPP Modem plugin"
PLUGIN_VERSION="1.0g"
PLUGIN_CONF_FILE="dsl-ppp-modem.conf"
#
# Last changed          : October 20, 2011
# Requirements          : ANF 3.0.0 (or newer)
# Comments              : This implements support for (A)DSL PPP modems
