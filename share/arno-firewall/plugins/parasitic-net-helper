# The plugin configuration file
###############################
PLUGIN_CONF_FILE="parasitic-net.conf"

# Rules added by this helper are tagged with the plugin name
NFT_COMMENT="parasitic-net"

# Preinit return value for success
PLUGIN_RET_VAL=0

# Check sanity of environment
parasitic_net_helper_sanity_check()
{
  # Check whether chain exists
  if ! $NFT list chain inet $NFT_TABLE PARASITIC_NET_ACL >/dev/null 2>&1; then
    echo "** ERROR: PARASITIC_NET_ACL does not exist! **" >&2
    return 1
  fi

  return 0
}


parasitic_net_helper_do_work()
{
  local RETVAL=0 deny_verdict

  # DROP or REJECT
  deny_verdict="$(echo "$PARASITIC_NET_DENY_POLICY" |tr 'A-Z' 'a-z')"

  # Rebuild the PARASITIC_NET_ACL in one atomic update
  nft_begin update
  nft_cmd "flush chain inet $NFT_TABLE PARASITIC_NET_ACL"

  unset IFS
  for rule in $PARASITIC_NET_HOST_DENY_TCP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_DENY_TCP "shosts:ANYHOST-dhosts-ports:ANYPORT"; then
      echo "${INDENT}Denying access from $shosts to $dhosts for TCP port(s): $ports"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping TCP deny rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in `nft_hosts "$shosts"`; do
            for port in $ports; do
              if [ "$PARASITIC_NET_DENY_LOG" = "1" ]; then
                nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) tcp dport $port limit rate 1/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
              fi

              nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) tcp dport $port $deny_verdict"
            done
          done
        done
      done
    fi
  done

  unset IFS
  for rule in $PARASITIC_NET_HOST_DENY_UDP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_DENY_UDP "shosts:ANYHOST-dhosts-ports:ANYPORT"; then
      echo "${INDENT}Denying access from $shosts to $dhosts for UDP port(s): $ports"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping UDP deny rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in `nft_hosts "$shosts"`; do
            for port in $ports; do
              if [ "$PARASITIC_NET_DENY_LOG" = "1" ]; then
                nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) udp dport $port limit rate 1/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
              fi

              nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) udp dport $port $deny_verdict"
            done
          done
        done
      done
    fi
  done

  unset IFS
  for rule in $PARASITIC_NET_HOST_DENY_ICMP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_DENY_ICMP "shosts:ANYHOST-dhosts"; then
      echo "${INDENT}Denying access from $shosts to $dhosts for ICMP requests"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping ICMP deny rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in `nft_hosts "$shosts"`; do
            if [ "$PARASITIC_NET_DENY_LOG" = "1" ]; then
              nft_rule PARASITIC_NET_ACL "$(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) icmp type echo-request limit rate 1/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
            fi

            nft_rule PARASITIC_NET_ACL "$(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) icmp type echo-request $deny_verdict"
          done
        done
      done
    fi
  done

  unset IFS
  for rule in $PARASITIC_NET_HOST_DENY_IP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_DENY_IP "shosts:ANYHOST-dhosts-protos"; then
      echo "${INDENT}Denying access from $shosts to $dhosts for IP protocol(s): $protos"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping IP deny rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in `nft_hosts "$shosts"`; do
            for proto in $protos; do
              if [ "$PARASITIC_NET_DENY_LOG" = "1" ]; then
                nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) meta l4proto $proto limit rate 1/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
              fi

              nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) meta l4proto $proto $deny_verdict"
            done
          done
        done
      done
    fi
  done

  unset IFS
  for rule in $PARASITIC_NET_HOST_OPEN_TCP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_OPEN_TCP "shosts:ANYHOST-dhosts-ports"; then
      echo "${INDENT}Allowing access from $shosts to $dhosts for TCP port(s): $ports"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping TCP allow rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in `nft_hosts "$shosts"`; do
            for port in $ports; do
              nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) tcp dport $port accept"
            done
          done
        done
      done
    fi
  done

  unset IFS
  for rule in $PARASITIC_NET_HOST_OPEN_UDP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_OPEN_UDP "shosts:ANYHOST-dhosts-ports"; then
      echo "${INDENT}Allowing access from $shosts to $dhosts for UDP port(s): $ports"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping UDP allow rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in `nft_hosts "$shosts"`; do
            for port in $ports; do
              nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) udp dport $port accept"
            done
          done
        done
      done
    fi
  done

  unset IFS

  for rule in $PARASITIC_NET_HOST_OPEN_ICMP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_OPEN_ICMP "shosts:ANYHOST-dhosts"; then
      echo "${INDENT}Allowing access from $shosts to $dhosts for ICMP requests"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping ICMP allow rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in $shosts; do
            nft_rule PARASITIC_NET_ACL "$(nft_addr saddr $shost_ip) $(nft_addr daddr $dhost_ip) icmp type echo-request accept"
          done
        done
      done
    fi
  done

  unset IFS
  for rule in $PARASITIC_NET_HOST_OPEN_IP; do
    if parse_rule "$rule" PARASITIC_NET_HOST_OPEN_IP "shosts:ANYHOST-dhosts-protos"; then
      echo "${INDENT}Allowing access from $shosts to $dhosts for IP protocol(s): $protos"

      IFS=' ,'
      for dhost in `nft_hosts "$dhosts"`; do
        if ! get_dynamic_host_cached $dhost || [ -z "$host_ip" ]; then
          echo "** WARNING: Skipping IP allow rule(s) for unresolvable host \"$dhost\"! **" >&2
          RETVAL=1
          continue
        fi

        for dhost_ip in $host_ip; do
          for shost_ip in $shosts; do
            for proto in $protos; do
              nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $(nft_addr daddr $dhost_ip) meta l4proto $proto accept"
            done
          done
        done
      done
    fi
  done

  # Set default policy
  if [ -z "$PARASITIC_NET_HOST_OPEN_TCP" ]; then
    nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 meta l4proto tcp accept"
  else
    if [ "$PARASITIC_NET_DENY_LOG" != "0" ]; then
      nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 meta l4proto tcp limit rate 12/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
    fi

    nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 meta l4proto tcp $deny_verdict"
  fi

  if [ -z "$PARASITIC_NET_HOST_OPEN_UDP" ]; then
    nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 meta l4proto udp accept"
  else
    if [ "$PARASITIC_NET_DENY_LOG" != "0" ]; then
      nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 meta l4proto udp limit rate 12/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
    fi

    nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 meta l4proto udp $deny_verdict"
  fi

  if [ -z "$PARASITIC_NET_HOST_OPEN_ICMP" ]; then
    nft_rule PARASITIC_NET_ACL "icmp type echo-request accept"
  else
    if [ "$PARASITIC_NET_DENY_LOG" != "0" ]; then
      nft_rule PARASITIC_NET_ACL "icmp type echo-request limit rate 12/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
    fi

    nft_rule PARASITIC_NET_ACL "icmp type echo-request $deny_verdict"
  fi

  # Drop the rest ("Other" IP protocols always need to be specified explicitly)
  if [ "$PARASITIC_NET_DENY_LOG" != "0" ]; then
    nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 limit rate 12/minute burst 5 packets log prefix \"AIF:Parasitic-net denied: \" level $LOGLEVEL"
  fi
  nft_rule PARASITIC_NET_ACL "meta nfproto ipv4 $deny_verdict"

  if ! nft_commit; then
    RETVAL=1
  fi

  return $RETVAL
}


############
# Mainline #
############

# Check where to find the config file
CONF_FILE=""
if [ -n "$PLUGIN_CONF_PATH" ]; then
  CONF_FILE="$PLUGIN_CONF_PATH/$PLUGIN_CONF_FILE"
fi

# Check if the config file exists
if [ ! -f "$CONF_FILE" ]; then
  echo "** ERROR: Config file \"$CONF_FILE\" not found! **" >&2
  PLUGIN_RET_VAL=1
else
  # Source the plugin config file
  . "$CONF_FILE"

  # Only proceed if environment ok
  if ! parasitic_net_helper_sanity_check; then
    PLUGIN_RET_VAL=1
  else
    if ! parasitic_net_helper_do_work; then
      PLUGIN_RET_VAL=1
    fi
  fi
fi
