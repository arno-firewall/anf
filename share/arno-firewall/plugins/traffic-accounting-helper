# The plugin configuration file
###############################
PLUGIN_CONF_FILE="traffic-accounting.conf"

# Rules added by this helper are tagged with the plugin name
NFT_COMMENT="traffic-accounting"

# Preinit return value for success
PLUGIN_RET_VAL=0

# Define some global variables
VERBOSE=0

# Check sanity of eg. environment
traffic_accounting_helper_sanity_check()
{
  # Check whether chains exists
  if ! $NFT list chain inet $NFT_TABLE ACCOUNTING_INPUT_CHAIN >/dev/null 2>&1; then
    echo "** ERROR: ACCOUNTING_INPUT_CHAIN does not exist! **" >&2
    return 1
  fi

  if ! $NFT list chain inet $NFT_TABLE ACCOUNTING_OUTPUT_CHAIN >/dev/null 2>&1; then
    echo "** ERROR: ACCOUNTING_OUTPUT_CHAIN does not exist! **" >&2
    return 1
  fi

  return 0
}


# Usage: counter_bytes NAME
# Prints the bytes of named counter NAME and resets it (0 if it doesn't exist)
counter_bytes()
{
  local bytes

  bytes="$($NFT reset counter inet $NFT_TABLE "$1" 2>/dev/null |sed -n -e 's/.*bytes \([0-9]*\).*/\1/p')"
  echo "${bytes:-0}"
}


traffic_accounting_helper_do_work()
{
  local RETVAL=0 host mon_host_ip name in_value out_value carry_in carry_out old_entry old_ip first LOG IFS
  local used=" "

  LOG="/var/log/traffic-accounting.log"

  # Touch the log file (just in case it doesn't exist yet):
  touch "$LOG"

  # Truncate file
  printf "" >/tmp/traffic-accounting.new

  if [ "$VERBOSE" = "1" ]; then
    echo "${INDENT}Traffic Accounting Hosts:"
    echo "${INDENT}-------------------------"
  fi

  # Rebuild the accounting chains in one atomic update, the named counters
  # keep counting while this runs and are read-and-reset per host IP
  nft_begin update
  nft_cmd "flush chain inet $NFT_TABLE ACCOUNTING_INPUT_CHAIN"
  nft_cmd "flush chain inet $NFT_TABLE ACCOUNTING_OUTPUT_CHAIN"

  # Also include default unicast route addresses, (0.0.0.0/0 and ::/0)
  DEFAULT_ADDR="0.0.0.0/0"
  if [ "$IPV6_SUPPORT" = "1" ]; then
    DEFAULT_ADDR="$DEFAULT_ADDR ::/0"
  fi

  IFS=' ,'
  for host in $TRAFFIC_ACCOUNTING_HOSTS $DEFAULT_ADDR; do
    # Get host_ip, if it fails, skip rule
    # Parse/get hostname. Try to use host cache if applicable
    # NOTE: get_dynamic_host_cached returns hostname in $host_ip
    if ! get_dynamic_host_cached $host || [ -z "$host_ip" ]; then
      echo "** WARNING: Skipping rule for \"$host\"! **" >&2
      RETVAL=1
      continue
    fi

    # Totals of IPs this host no longer has (eg. dynamic DNS) are carried over to its first current IP
    carry_in=0
    carry_out=0
    IFS=$EOL
    for old_entry in $(grep "^$host " "$LOG"); do
      old_ip="$(echo "$old_entry" |cut -s -d' ' -f2)"
      case " $(echo "$host_ip" |tr ',' ' ') " in
        *" $old_ip "*) ;;
        *) name="acct_$(echo "$host $old_ip" |tr -c 'A-Za-z0-9\n' '_')"
           carry_in=$(( carry_in + $(echo "$old_entry" |cut -s -d' ' -f3 |grep . || echo 0) + $(counter_bytes ${name}_in) ))
           carry_out=$(( carry_out + $(echo "$old_entry" |cut -s -d' ' -f4 |grep . || echo 0) + $(counter_bytes ${name}_out) ))
           if $NFT list counter inet $NFT_TABLE ${name}_in >/dev/null 2>&1; then
             nft_cmd "delete counter inet $NFT_TABLE ${name}_in"
             nft_cmd "delete counter inet $NFT_TABLE ${name}_out"
           fi
           ;;
      esac
    done

    first=1
    IFS=' ,'
    for mon_host_ip in $host_ip; do
      echo "${INDENT}Monitoring host \"$host\" with IP: $mon_host_ip"

      # Counters are named after host and IP, eg. acct_example_com_192_0_2_1_in
      name="acct_$(echo "$host $mon_host_ip" |tr -c 'A-Za-z0-9\n' '_')"

      old_entry="$(grep "^$host $mon_host_ip " "$LOG" |head -n1)"
      in_value=$(( $(echo "$old_entry" |cut -s -d' ' -f3 |grep . || echo 0) + $(counter_bytes ${name}_in) ))
      out_value=$(( $(echo "$old_entry" |cut -s -d' ' -f4 |grep . || echo 0) + $(counter_bytes ${name}_out) ))
      if [ $first -eq 1 ]; then
        in_value=$((in_value + carry_in))
        out_value=$((out_value + carry_out))
        first=0
      fi

      nft_cmd "add counter inet $NFT_TABLE ${name}_in"
      nft_cmd "add counter inet $NFT_TABLE ${name}_out"
      nft_rule ACCOUNTING_INPUT_CHAIN "$(nft_addr saddr $mon_host_ip) counter name \"${name}_in\" return"
      nft_rule ACCOUNTING_OUTPUT_CHAIN "$(nft_addr daddr $mon_host_ip) counter name \"${name}_out\" return"

      if [ "$VERBOSE" = "1" ]; then
        echo "${INDENT}  in=$in_value out=$out_value"
      fi

      # Create entry in accounting file
      echo "$host $mon_host_ip $in_value $out_value" >>/tmp/traffic-accounting.new
    done
  done

  if ! nft_commit; then
    RETVAL=1
  fi

  # FIXME: Don't use old-file
  if [ -f "$LOG" ]; then
    if [ -f "$LOG.old" ]; then
      rm -f "$LOG.old"
    fi

    mv "$LOG" "$LOG.old"
  fi
  mv /tmp/traffic-accounting.new "$LOG"

  return $RETVAL
}


############
# Mainline #
############

if [ "$1" = "-v" -o "$1" = "--verbose" ]; then
  VERBOSE=1
fi

# Check where to find the config file
CONF_FILE=""
if [ -n "$PLUGIN_CONF_PATH" ]; then
  CONF_FILE="$PLUGIN_CONF_PATH/$PLUGIN_CONF_FILE"
fi

# Check if the config file exists
if [ ! -f "$CONF_FILE" ]; then
  echo "** ERROR: Config file \"$CONF_FILE\" not found! **" >&2
  PLUGIN_RET_VAL=1
else
  # Source the plugin config file
  . "$CONF_FILE"

  # Only proceed if environment ok
  if ! traffic_accounting_helper_sanity_check; then
    PLUGIN_RET_VAL=1
  else
    # Create actual rules
    if ! traffic_accounting_helper_do_work; then
      PLUGIN_RET_VAL=1
    fi
  fi
fi
