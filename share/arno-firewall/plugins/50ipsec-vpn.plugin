PLUGIN_NAME="IPsec VPN plugin"
PLUGIN_VERSION="0.85"
PLUGIN_CONF_FILE="ipsec-vpn.conf"
#
# Last changed          : July 12, 2016
# Requirements          : ANF 3.0.0 (or newer)
# Comments              : This plugin adds all required rules for using Racoon IPSEC.
