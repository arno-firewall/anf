# along with this program; if not, write to the Free Software
# Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
# ------------------------------------------------------------------------------

# Plugin start function
plugin_start()
{
  local family type families host port interface IFS

  if [ "$IPV6_DETECTED" = "1" ] && [ "$SSH_BFP_IPV6_ENABLE" = "0" ]; then
    echo "${INDENT}NOTE: Only IPv4 is protected."
  fi


  # Create new SSH_CHK to insert SSH checker + whitelist:
  nft_chain SSH_CHK

  # Create new SSH_LOG_DROP chain for loggin' 'n droppin':
  nft_chain SSH_LOG_DROP

  nft_rule SSH_LOG_DROP "limit rate 1/minute burst 1 packets log prefix \"ANF:SSH Brute force attack?: \" level $LOGLEVEL"
  nft_rule SSH_LOG_DROP "drop"

  if [ -n "$SSH_BFP_TRUSTED_HOSTS" ]; then
    # Create whitelist:
    echo "${INDENT}Allowing bypass of SSH protection checks for: $SSH_BFP_TRUSTED_HOSTS"
    IFS=' ,'
    for host in `nft_hosts "$SSH_BFP_TRUSTED_HOSTS"`; do
      nft_rule SSH_CHK "$(nft_addr saddr $host) return"
    done
  fi

  # Create rate1 & rate2 checker:
  # Without IPv6 protection, IPv6 bypasses the checks (as it always did)
  if [ "$SSH_BFP_IPV6_ENABLE" = "0" ]; then
    nft_rule SSH_CHK "meta nfproto ipv6 return"
  fi

  # Create rate1 & rate2 checker, per source address in a dynamic set:
  for family in ip ip6; do
    if [ "$family" = "ip" ]; then type="ipv4_addr"; else type="ipv6_addr"; fi
    nft_cmd "add set inet $NFT_TABLE aif_sshchk1_$family { type $type; flags dynamic,timeout; timeout ${SSH_BFP_MAX_TIME1}s; }"
    nft_cmd "add set inet $NFT_TABLE aif_sshchk2_$family { type $type; flags dynamic,timeout; timeout ${SSH_BFP_MAX_TIME2}s; }"
    nft_rule SSH_CHK "update @aif_sshchk1_$family { $family saddr $(nft_rate $SSH_BFP_MAX_RATE1 $SSH_BFP_MAX_TIME1) } jump SSH_LOG_DROP"
    nft_rule SSH_CHK "update @aif_sshchk2_$family { $family saddr $(nft_rate $SSH_BFP_MAX_RATE2 $SSH_BFP_MAX_TIME2) } jump SSH_LOG_DROP"
  done

  # If no ports were not configured, use default of 22
  if [ -z "$SSH_BFP_PORTS" ]; then
    SSH_BFP_PORTS="22"
  fi

  echo "${INDENT}Protecting TCP port(s): $SSH_BFP_PORTS"

  # Insert rule into the EXTERNAL INPUT chain:
  IFS=' ,'
  for port in $SSH_BFP_PORTS; do
    nft_rule EXT_INPUT_CHAIN "ct state new tcp dport $port jump SSH_CHK"
  done

  return 0
}


# Plugin stop function
plugin_stop()
{
  return 0
}


# Plugin status function
plugin_status()
{
  return 0
}


# Check sanity of eg. environment
plugin_sanity_check()
{
  if [ -z "$SSH_BFP_MAX_RATE1" -o -z "$SSH_BFP_MAX_TIME1" -o -z "$SSH_BFP_MAX_RATE2" -o -z "$SSH_BFP_MAX_TIME2" ]; then
    printf "\033[40m\033[1;31m${INDENT}ERROR: The plugin config file is not properly set!\033[0m\n" >&2
    return 1
  fi

  return 0
}


############
# Mainline #
############

# Check where to find the config file
CONF_FILE=""
if [ -n "$PLUGIN_CONF_PATH" ]; then
  CONF_FILE="$PLUGIN_CONF_PATH/$PLUGIN_CONF_FILE"
fi

# Preinit to success:
PLUGIN_RET_VAL=0

# Check if the config file exists
if [ ! -f "$CONF_FILE" ]; then
  printf "NOTE: Config file \"$CONF_FILE\" not found!\n        Plugin \"$PLUGIN_NAME v$PLUGIN_VERSION\" ignored!\n" >&2
else
  # Source the plugin config file
  . "$CONF_FILE"

  if [ "$ENABLED" = "1" ] ||
     [ -n "$PLUGIN_LOAD_FILE" -a "$PLUGIN_CMD" = "stop" ] ||
     [ -n "$PLUGIN_LOAD_FILE" -a "$PLUGIN_CMD" = "status" ]; then
    # Show who we are:
    echo "${INDENT}$PLUGIN_NAME v$PLUGIN_VERSION"

    # Increment indention
    INDENT="$INDENT "

    # Only proceed if environment ok
    if ! plugin_sanity_check; then
      PLUGIN_RET_VAL=1
    else
      case $PLUGIN_CMD in
        start|'') plugin_start; PLUGIN_RET_VAL=$? ;;
        stop    ) plugin_stop; PLUGIN_RET_VAL=$? ;;
        status  ) plugin_status; PLUGIN_RET_VAL=$? ;;
        *       ) PLUGIN_RET_VAL=1; printf "\033[40m\033[1;31m${INDENT}ERROR: Invalid plugin option \"$PLUGIN_CMD\"!\033[0m\n" >&2 ;;
      esac
    fi
  fi
fi
