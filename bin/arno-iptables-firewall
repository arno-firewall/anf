MY_VERSION="2.1.2b-DEVEL"

# Location of the main configuration file for the firewall
##########################################################
CONFIG_FILE=/etc/arno-iptables-firewall/firewall.conf

# ------------------------------------------------------------------------------
#                         -= Arno's Iptables Firewall(AIF) =-
