        for dhost in `nft_hosts "$dhosts"`; do
          for port in $ports; do
            for interface in $interfaces; do
              nft_rule DMZ_INET_FORWARD_CHAIN "$(nft_if oifname "$interface") $(nft_addr saddr $shost) $(nft_addr daddr $dhost) tcp dport $port accept"
            done
          done
        done
      done
    fi
  done

  # UDP ports to ALLOW for certain DMZ hosts
  #########################################
