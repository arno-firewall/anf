# Port ranges: (first, last, name with {} for the port)
PORT_RANGES = [
    (16384, 16472, 'Real-Time Transport Protocol(RTP) ({})'),
    (27910, 27961, 'Quake({})'),
    (28000, 28008, 'Starsiege Tribes({})'),
    (32770, 32900, 'SUN-RPC Portmapper({})'),
    (33434, 33600, 'Traceroute?({})'),
]

# ICMP (type, code) names
ICMP_NAMES = {
    (0, 0): 'Echo reply',
    (3, 0): 'Network unreachable',
    (3, 1): 'Host unreachable',
    (3, 2): 'Protocol unreachable',
    (3, 3): 'Port unreachable',
    (3, 4): 'Fragmentation needed but no frag. bit set',
    (3, 5): 'Source routing failed',
    (3, 6): 'Destination network unknown',
    (3, 7): 'Destination host unknown',
    (3, 8): 'Source host isolated',
    (3, 9): 'Destination network administratively prohibited',
    (3, 10): 'Destination host administratively prohibited',
    (3, 11): 'Network unreachable for TOS',
    (3, 12): 'Host unreachable for TOS',
    (3, 13): 'Communication administratively prohibited by filtering',
    (3, 14): 'Host precedence violation',
    (3, 15): 'Precedence cutoff in effect',
    (4, 0): 'Source quench',
    (5, 0): 'Redirect for network',
    (5, 1): 'Redirect for host',
    (5, 2): 'Redirect for TOS and network',
    (5, 3): 'Redirect for TOS and host',
    (8, 0): 'Echo request',
    (9, 0): 'Router advertisement',
    (9, 16): 'Does not route common traffic',
    (10, 0): 'Route solicitation',
    (11, 0): 'TTL equals 0 during transit',
    (11, 1): 'TTL equals 0 during reassembly',
    (12, 0): 'IP header bad (catchall error)',
    (12, 1): 'Required options missing',
    (12, 2): 'Bad Length',
    (13, 0): 'Timestamp request',
    (14, 0): 'Timestamp reply (obsolete)',
    (15, 0): 'Information request',
    (16, 0): 'Information reply',
    (17, 0): 'Address mask request',
    (18, 0): 'Address mask reply',
    (30, 0): 'Outbound Packet succesfully forwarded',
    (30, 1): 'No route for Outbound Packet; packet discarded',
    (40, 0): 'Bad SPI',
    (40, 1): 'Authentication Failed',
    (40, 2): 'Decompression Failed',
    (40, 3): 'Decryption Failed',
    (40, 4): 'Need Authentication',
    (40, 5): 'Need Authorization',
}

# (ANSI color, HTML color) per kind of field
COLORS = {
    'src': ('\033[0m\033[1;36m', 'turquoise'),
    'dst': ('\033[0m\033[1;35m', 'dark purple'),
    'UDP': ('\033[0m\033[1;33m', 'yellow'),
    'TCP': ('\033[0m\033[1;32m', 'green'),
    'ICMP': ('\033[0m\033[1;34m', 'blue'),
    'port': ('\033[0m\033[1;31m', 'red'),
}


def strtonum(s):
    """Like gawk's strtonum(): leading digits only, 0x = hex, leading 0 = octal, else 0"""
    s = s.strip()
    try:
        if s[:2].lower() == '0x':
            return int(s[2:], 16)
        if s[:1] == '0' and len(s) > 1:
            return int(s, 8)
        digits = ''
        for c in s:
            if not c.isdigit():
                break
            digits += c
        return int(digits) if digits else 0
    except ValueError:
        return 0


def portname_lookup(port_str):
    port = strtonum(port_str)
    if port == 0:
        return 'Invalid Port(0)'
    if port in PORT_NAMES:
        return PORT_NAMES[port]
    for first, last, name in PORT_RANGES:
        if first <= port <= last:
            return name.format(port)
    # If nothing else matches just return the port number
    return port_str


def icmp_lookup(icmp_type, code):
    return ICMP_NAMES.get((icmp_type, code), 'Unknown ICMP type/code')


def color_on(kind):
    out = ''
    if USE_ANSI_COLORS == 1:
        out += COLORS[kind][0]
    if USE_HTML == 1:
        out += '<font color=%s>' % COLORS[kind][1]
    return out


def color_off():
    out = ''
    if USE_ANSI_COLORS == 1:
        out += '\033[0m'
    if USE_HTML == 1:
        out += '</font>'
    return out


def newline_indent():
    return '<br>\n                         ' if USE_HTML == 1 else '\n               '


CONFIG_FILE = '/etc/arno-firewall/arno-fwfilter.conf'
CONFIG_OPTIONS = ('RESOLVE_NAMES', 'SHOW_LOCATION', 'USE_ANSI_COLORS', 'USE_HTML', 'USE_1ROW')


def load_config(path):
    """Settings from the config file (KEY=value lines, # comments). It's optional: when
    it's missing (or unusable) the defaults above apply"""
    if not os.path.exists(path):
        return
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            lines = f.read().splitlines()
    except OSError as err:
        print('arno-fwfilter: WARNING: Unable to read %s: %s' % (path, err.strerror), file=sys.stderr)
        return

    for num, line in enumerate(lines, 1):
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        shown = ''.join(c if c.isprintable() else '?' for c in line)
        key, sep, value = line.partition('=')
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if not sep or key not in CONFIG_OPTIONS:
            print('arno-fwfilter: WARNING: Unknown setting in %s line %d: %s' % (path, num, shown), file=sys.stderr)
        elif value not in ('0', '1'):
            print('arno-fwfilter: WARNING: Invalid value in %s line %d: %s (use 0 or 1)' % (path, num, shown), file=sys.stderr)
        else:
            globals()[key] = int(value)


NAME_CACHE = {}


def resolve_name(ip):
    """First name of ip (via dig), without a name (or dig) the ip itself"""
    if ip not in NAME_CACHE:
        name = ''
        try:
            out = subprocess.run(['dig', '+short', '+time=1', '+tries=1', '-x', ip],
                                 capture_output=True, text=True, timeout=5).stdout
            lines = [l for l in out.splitlines() if l and not l.startswith(';;')]
            if lines:
                name = lines[0][:-1] if lines[0].endswith('.') else lines[0]
        except (OSError, subprocess.SubprocessError):
            pass
        NAME_CACHE[ip] = name or ip
    return NAME_CACHE[ip]


LOCATION_CACHE = {}


def location(ip):
    if ip not in LOCATION_CACHE:
        result = ''
        try:
            with urllib.request.urlopen('http://api.hostip.info/get_html.php?ip=%s' % ip, timeout=1) as r:
                for line in r.read().decode(errors='replace').splitlines():
                    if 'Country:' in line or 'City:' in line:
                        result += ' ' + line
        except Exception:
            pass
        LOCATION_CACHE[ip] = result
    return LOCATION_CACHE[ip]


def host(ip, kind, port=''):
    """Name (or IP) of ip with :port, and its location if enabled, in the color of kind"""
    name = resolve_name(ip) if RESOLVE_NAMES == 1 else ip
    if port:
        # An IPv6 address (no name) needs brackets around it, as it contains colons itself
        name = '[%s]:%s' % (name, port) if ':' in name else '%s:%s' % (name, port)
    out = color_on(kind) + ' ' + name
    if SHOW_LOCATION == 1:
        out += location(ip)
    return out + color_off()


def hosts_info(src_ip, dst_ip, src_port='', dst_port=''):
    """Both hosts (and ports) on one line: src:port -> dst:port"""
    out = ''
    if RESOLVE_NAMES == 1 or SHOW_LOCATION == 1:
        if USE_1ROW == 0:
            out += newline_indent()
        out += host(src_ip, 'src', src_port) + ' ->' + host(dst_ip, 'dst', dst_port)
    return out


def filter_line(line):
    """Returns the formatted line (without newline), or None when it's not a firewall log line"""
    if not ('IN=' in line or 'firewall' in line or 'Firewall' in line or 'kernel' in line):
        return None

    if 'IN=' not in line:
        return line

    f = [''] + line.split()     # f[1]..f[nf], like awk's $1..$NF
    nf = len(f) - 1
    field = lambda n: f[n] if 1 <= n <= nf else ''
    out = ''
    src_host = dst_host = ''

    # First show message, SRC etc.
    i = 1
    while i <= nf:
        fi = f[i]
        if fi[:4] == 'SRC=':
            src_host = fi[4:]
        if fi[:4] == 'DST=':
            dst_host = fi[4:]

        if fi[:4] not in ('MAC=', 'SRC=', 'DST=') and fi not in ('IN=', 'OUT='):
            if field(i + 1) != 'kernel:' and fi not in ('kernel:', '[kernel]'):
                if i == 1:
                    out += fi
                elif i == 2 and len(f[2]) == 1:
                    # We always want 2 digits for the date-day:
                    out += ' 0' + fi
                else:
                    out += ' ' + fi

        if fi[:4] == 'SRC=':
            out += color_on('src') + ' ' + fi + color_off()

        if fi[:4] == 'DST=':
            # Show destination
            out += color_on('dst') + ' ' + fi + color_off()
            break
        i += 1

    offset = 0
    if i == nf:
        if USE_HTML == 1:
            out += '<br>'
        out += '\n'
    else:
        offset = i + 1
        out += newline_indent() if USE_1ROW == 0 else ' '

    offset += 1
    save_offset = offset
    i = offset
    while i <= nf and field(i)[:6] != 'PROTO=':
        i += 1
    offset = i

    # First show PROTO=
    proto = field(offset)
    if proto in ('PROTO=UDP', 'PROTO=TCP', 'PROTO=ICMP'):
        out += color_on(proto[6:]) + ' ' + proto + color_off()
    else:
        out += ' ' + proto

    src_port = dst_port = ''
    if field(offset + 1)[:4] == 'SPT=':
        # The ports of this packet (not those of an ICMP payload), for the hosts line
        src_port = field(offset + 1)[4:]
        if field(offset + 2)[:4] == 'DPT=':
            dst_port = field(offset + 2)[4:]

        # Second show DPT=, third SPT=
        out += color_on('port') + ' DPT=%s' % portname_lookup(field(offset + 2)[4:]) + color_off()
        out += ' SPT=%s' % portname_lookup(field(offset + 1)[4:])

    if proto == 'PROTO=ICMP':
        # Resolve type/code
        icmp_type = strtonum(field(offset + 1)[5:])
        code = strtonum(field(offset + 2)[5:])
        out += color_on('port') + ' TYPE/CODE=%s(%d,%d)' % (icmp_lookup(icmp_type, code), icmp_type, code) + color_off()

    # Show all other info
    icmp_info = 0
    for i in range(save_offset, nf + 1):
        fi = f[i]
        if fi[:1] == '[':
            icmp_info = 1
        if icmp_info == 1:
            if (fi[:5] != 'PREC=' and fi[:4] != 'TOS=' and fi[:3] != 'ID=' and i != 4 and i != 5
                    and fi[:2] != 'DF' and fi != 'RES=0x00' and fi != 'URGP=0'):
                out += ' ' + fi
        else:
            if (fi[:6] != 'PROTO=' and fi[:5] != 'PREC=' and fi[:4] != 'TOS=' and fi[:3] != 'ID='
                    and fi[:4] != 'LEN=' and i != 4 and i != 5 and fi[:2] != 'DF' and fi[:4] != 'SPT='
                    and fi[:4] != 'DPT=' and fi != 'RES=0x00' and fi != 'URGP=0' and fi[:7] != 'WINDOW='
                    and fi[:5] != 'TYPE=' and fi[:5] != 'CODE='):
                out += ' ' + fi

    # Last the hosts (and ports): src:port -> dst:port
    if dst_host:
        out += hosts_info(src_host, dst_host, src_port, dst_port)
    return out


def usage():
    print('Options:')
    print('-h, --help         - Print this help')
    print('-r, --no-resolve   - Disable resolving of IPs to names')
    print('-o, --html-output  - Use basic HTML to format the output')
    print('-l, --no-locations - Disable obtaining the IPs geographical location')
    print('-c, --no-colors    - Disable the use of (ANSI) colors in the output')
    print('-s, --single-line  - Put all information about an event in a single line')
    print('')
    print('Settings: %s (command line options override them)' % CONFIG_FILE)


def main():
    global RESOLVE_NAMES, SHOW_LOCATION, USE_ANSI_COLORS, USE_HTML, USE_1ROW

    load_config(CONFIG_FILE)

    try:
        opts, _ = getopt.gnu_getopt(sys.argv[1:], 'hrolcs',
                                    ['help', 'no-resolve', 'html-output', 'no-locations', 'no-colors', 'single-line'])
    except getopt.GetoptError as err:
        print('arno-fwfilter: %s' % err, file=sys.stderr)
        print('Terminating...', file=sys.stderr)
        sys.exit(1)

    for opt, _ in opts:
        if opt in ('-r', '--no-resolve'):
            RESOLVE_NAMES = 0
        elif opt in ('-o', '--html-output'):
            USE_HTML = 1
        elif opt in ('-l', '--no-locations'):
            SHOW_LOCATION = 0
        elif opt in ('-c', '--no-colors'):
            USE_ANSI_COLORS = 0
        elif opt in ('-s', '--single-line'):
            USE_1ROW = 1
        elif opt in ('-h', '--help'):
            usage()
            sys.exit(0)

    if USE_HTML == 1:
        print('<html><head><title>Firewall Log</title>')
        print('<meta http-equiv="Content-Type" content="text/html; charset=us-ascii"></head>')
        print('<body>')

    try:
        # readline() instead of iterating, so lines are processed as soon as they arrive (eg. journalctl -f)
        for line in iter(sys.stdin.readline, ''):
            result = filter_line(line.rstrip('\n'))
            if result is not None:
                sys.stdout.write(result + ('<br>' if USE_HTML == 1 else '') + '\n')
                sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:
        sys.exit(0)

    if USE_HTML == 1:
        print('</body></html>')


if __name__ == '__main__':
    # Log lines may contain arbitrary bytes, never fail on them (also with a C locale)
    sys.stdin.reconfigure(errors='replace')
    sys.stdout.reconfigure(errors='replace')
    main()
